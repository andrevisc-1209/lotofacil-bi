# Copie este arquivo para ".env" (sem o .example) e preencha com os valores
# reais do seu projeto — Supabase > Settings > API.
#
# ".env" nunca deve ser commitado (já está no .gitignore).

# Project URL
SUPABASE_URL=https://SEU_PROJETO.supabase.co

# "anon" "public" — chave pública, só leitura (RLS). Pode ir no HTML.
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# "service_role" "secret" — chave privada, ignora RLS. Usada só pelos
# scripts de atualização/migração (lotofacil_atualizar.py, lotofacil_migrar.py)
# e pelo GitHub Actions. NUNCA vai no HTML nem em qualquer arquivo commitado.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
